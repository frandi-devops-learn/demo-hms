# Copy this file to .env and replace every CHANGE_ME value before starting.
# Never commit the real .env file.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=hotel
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://hotel:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/hotel

REDIS_URL=redis://redis:6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

RABBITMQ_USER=hotel
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://hotel:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
INTERNAL_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=false

API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ROOM_SERVICE_PORT=3003
BOOKING_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
OPERATIONS_SERVICE_PORT=3007
FRONTEND_PORT=8080
API_GATEWAY_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1

AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://users-service:3002
ROOM_SERVICE_URL=http://rooms-service:3003
BOOKING_SERVICE_URL=http://bookings-service:3004
NOTIFICATION_SERVICE_URL=http://notifications-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3006
OPERATIONS_SERVICE_URL=http://operations-service:3007
API_GATEWAY_URL=http://api-gateway:3000

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=USD

# Structured logging and Docker log rotation.
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
LOG_HEALTH_REQUESTS=false
LOG_CLIENT_IP=false
SERVICE_VERSION=development
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Loki, Alloy and Grafana. Pin image versions explicitly for production releases.
DEPLOYMENT_ENV=development
LOKI_IMAGE=grafana/loki:3.5.3
ALLOY_IMAGE=grafana/alloy:v1.10.2
GRAFANA_IMAGE=grafana/grafana:12.1.1
LOKI_RETENTION_PERIOD=168h
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=3200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
